[Unit]
Description=Nyx Voice (dictation, listening and speaking)
Documentation=https://github.com/design-nexus/nyx-voice
Requires=nyx-voiced.socket
After=nyx-voiced.socket pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/nyx-voiced
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
Also=nyx-voiced.socket
